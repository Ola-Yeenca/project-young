# Copy to .env.local for local work. In production set it in the host's dashboard.

# The Django API, including /api/v1. Read at build time (next build) as well as at run time,
# so changing it needs a rebuild. Production: https://api.fromthehouseofyoung.com/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8017/api/v1
