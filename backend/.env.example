# Copy to .env for local work. In production set these in the host's dashboard.

# Core
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Europe/Madrid

# Database. Leave unset to use SQLite locally. Production: Postgres.
# DATABASE_URL=postgres://user:password@host:5432/hoy

# Media storage (any S3-compatible bucket; production uses Supabase Storage). Leave unset to store uploads on local disk.
# AWS_STORAGE_BUCKET_NAME=hoy-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://voctydqabimqsliyqhyk.storage.supabase.co/storage/v1/s3
# AWS_S3_REGION_NAME=eu-west-3
# AWS_S3_CUSTOM_DOMAIN=voctydqabimqsliyqhyk.supabase.co/storage/v1/object/public/hoy-media

# Email (Resend, Postmark or any SMTP). Debug mode prints emails to the console instead.
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=House of Young <hello@houseofyoung.example>
HOY_TEAM_EMAIL=team@houseofyoung.example

# Spam protection on the enquiry forms (per visitor IP)
HOY_ENQUIRY_RATE=10/hour

# Proxies in front of the app that append to X-Forwarded-For (Railway: 1). The visitor's address,
# used for sign-in lockouts, rate limits and gallery stats, is read from that hop.
HOY_TRUSTED_PROXIES=1

# Error reporting. Leave SENTRY_DSN unset to keep Sentry off.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# First admin (created once on deploy by `manage.py ensure_admin`; existing users are never changed)
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
